  "description": "A JavaScript library for rendering music notation and guitar tablature.",
  "exports": {
    ".": {
      "require": "./dist/cjs/entry/vexflow.js",
      "import": "./dist/esm/entry/vexflow.js",
      "types": "./dist/types/entry/vexflow.d.ts"
    }
  },
  "files": [
    "build",
    "dist",
    "entry",
    "src"
  ],
  "keywords": [
    "music",
    "notation",
    "piano",
    "guitar",
    "tablature"
  ],
  "license": "MIT",
  "main": "./dist/cjs/entry/vexflow.js",
  "module": "./dist/esm/entry/vexflow.js",
  "types": "./dist/types/entry/vexflow.d.ts",
  "name": "@aurokk/vexflow",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aurokk/vexflow.git",
    "directory": "vexflow"
  },
  "scripts": {
    "build:dev:run": "npm-run-all build:dev:run:*",
    "build:dev:run:esm": "tsc --project tsconfig.dev.esm.json",
    "build:dev:run:cjs": "tsc --project tsconfig.dev.cjs.json",
    "build:dev:run:types": "tsc --project tsconfig.dev.types.json",
    "build:dev:watch": "npm-run-all build:dev:watch:*",
    "build:dev:watch:esm": "tsc --project tsconfig.dev.esm.json --watch",
    "build:dev:watch:cjs": "tsc --project tsconfig.dev.cjs.json --watch",
    "build:dev:watch:types": "tsc --project tsconfig.dev.types.json --watch",
    "build:prod:run": "npm-run-all build:prod:run:*",
    "build:prod:run:esm": "tsc --project tsconfig.prod.esm.json",
    "build:prod:run:cjs": "tsc --project tsconfig.prod.cjs.json",
    "build:prod:run:types": "tsc --project tsconfig.prod.types.json",
    "test:ci:run": "VEXFLOW_VISUAL_REGRESSION=1 vitest run --config vitest.config.ci.ts",
    "test:dev:run": "vitest run --ui --config vitest.config.dev.ts",
    "test:dev:run:visual": "VEXFLOW_VISUAL_REGRESSION=1 vitest run --ui --config vitest.config.dev.ts",
    "test:dev:watch": "vitest --ui --config vitest.config.dev.ts",
    "test:dev:watch:visual": "VEXFLOW_VISUAL_REGRESSION=1 vitest --ui --config vitest.config.dev.ts"
  },
  "version": "1.2.0"
}
