  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "outDir": "./dist/types",
    "skipLibCheck": true,
    "strict": true,
    "target": "es6"
  },
  "include": ["./src", "./entry"]
}
