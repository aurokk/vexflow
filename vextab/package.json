  "dependencies": {
    "@aurokk/vexflow": "^1.3.0",
    "lodash": "^4.17.21",
    "ts-node": "^10.9.2"
  },
  "description": "A VexTab Parser for VexFlow",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.7.0",
    "@types/qunit": "^2.19.13",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.4.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^3.6.0",
    "eslint": "^9.38.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-import": "^2.32.0",
    "git-revision-webpack-plugin": "^3.0.6",
    "html-webpack-plugin": "^5.6.4",
    "jison": "^0.4.18",
    "jison-loader": "^1.0.0",
    "qunit": "^2.24.1",
    "semantic-release": "^24.2.9",
    "style-loader": "^1.3.0",
    "ts-loader": "^8.4.0",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "zepto-webpack": "^1.2.1"
  },
  "files": [
    "build",
    "dist",
    "entry",
    "src"
  ],
  "keywords": [
    "music",
    "notation",
    "guitar",
    "tablature"
  ],
  "license": "MIT",
  "name": "@aurokk/vextab",
  "main": "dist/main.dev.js",
  "types": "dist/src/main.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aurokk/vextab.git",
    "directory": "vextab"
  },
  "scripts": {
    "build": "webpack --progress --mode production --env NODE_ENV=production --env TAG_NAME=prod --config webpack.config.ts && tsc --emitDeclarationOnly",
    "build-dev": "webpack --progress --mode development --env NODE_ENV=development --env TAG_NAME=dev --config webpack.config.ts && tsc --emitDeclarationOnly",
    "start": "webpack-dev-server --progress --mode development --port 9005 --allowed-hosts all --env NODE_ENV=development --env TAG_NAME=dev --config webpack.config.ts",
    "serve": "npx http-server -c 1 -p 8052",
    "watch": "webpack -w --progress --mode development --env NODE_ENV=development --env TAG_NAME=dev --config webpack.config.ts",
    "clean": "rm -rf ./dist/*"
  },
  "version": "1.2.1"
}
